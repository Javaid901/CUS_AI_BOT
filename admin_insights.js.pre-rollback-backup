  function changeQueriesLogPage(page) {
    if (page < 1 || page > _queriesLogState.totalPages) return;
    _queriesLogState.page = page;
    fetchQueriesLogs(getPeriod());
  }

  function toggleQueriesLogSelectAll(headerCheckbox) {
    var checked = headerCheckbox.checked;
    document.querySelectorAll(".queries-log-row-checkbox").forEach(function (cb) {
      cb.checked = checked;
      toggleQueriesLogRowSelect(cb);
    });
  }

  function toggleQueriesLogRowSelect(checkbox) {
    var id = checkbox.value;
    var row = checkbox.closest("tr");
    if (checkbox.checked) {
      _queriesLogState.selectedLogs.add(id);
      if (row) row.classList.add("selected");
    } else {
      _queriesLogState.selectedLogs.delete(id);
      if (row) row.classList.remove("selected");
    }
    var headerCheckbox = document.getElementById("queriesLogSelectAll");
    if (headerCheckbox) {
      var allChecked = document.querySelectorAll(".queries-log-row-checkbox:checked").length === document.querySelectorAll(".queries-log-row-checkbox").length;
      headerCheckbox.checked = allChecked;
    }
    updateQueriesLogSelectedCountDisplay();
  }

  function updateQueriesLogSelectedCountDisplay() {
    var count = _queriesLogState.selectedLogs.size;
    var countEl = document.getElementById("queriesLogSelectedCount");
    var deleteBtn = document.getElementById("queriesLogDeleteSelectedBtn");
    if (count > 0) {
      if (countEl) countEl.textContent = count + ' selected';
      if (deleteBtn) deleteBtn.style.display = '';
    } else {
      if (countEl) countEl.textContent = '';
      if (deleteBtn) deleteBtn.style.display = 'none';
    }
  }

  function deleteSelectedQueriesLogs() {
    if (_queriesLogState.selectedLogs.size === 0) return;
    if (!confirm("Delete " + _queriesLogState.selectedLogs.size + " selected activity logs?")) return;
    var ids = Array.from(_queriesLogState.selectedLogs);
    fetchJSON(BASE + "/logs/bulk-delete", {
      method: "POST",
      headers: { "Content-Type": "application/json", ...authHeaders() },
      body: JSON.stringify({ ids: ids })
    }).then(function (result) {
      var deleted = result.deleted || 0;
      var failed = result.failed || 0;
      if (failed > 0) {
        toast(deleted + " query logs deleted successfully. " + failed + " failed.", "warning");
      } else {
        toast(deleted + " query logs deleted successfully.", "success");
      }
      _queriesLogState.selectedLogs.clear();
      fetchQueriesLogs(getPeriod());
      updateQueriesLogSelectedCountDisplay();
    }).catch(function (err) {
      toast("Failed to delete query logs. Please try again.", "error");
    });
  }

