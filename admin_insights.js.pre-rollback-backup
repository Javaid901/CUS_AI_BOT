  function fetchQueriesLogs(period) {
    showLoading("queriesLogContent");
    var params = new URLSearchParams();
    params.append("period", period);
    params.append("page", _queriesLogState.page);
    params.append("page_size", _queriesLogState.pageSize);
    var f = _queriesLogState.filters;
    if (f.search) params.append("search", f.search);
    if (f.activity_type) params.append("activity_type", f.activity_type);
    if (f.result_status) params.append("result_status", f.result_status);
    if (f.category) params.append("category", f.category);
    if (f.programme) params.append("programme", f.programme);
    if (f.college) params.append("college", f.college);
    if (f.service) params.append("service", f.service);
    if (f.date_from) params.append("date_from", f.date_from);
    if (f.date_to) params.append("date_to", f.date_to);

    fetchJSON(BASE + "/logs?" + params.toString()).then(function (data) {
      _queriesLogState.logs = data.logs || [];
      _queriesLogState.total = data.total || 0;
      _queriesLogState.totalPages = data.total_pages || 1;
      _queriesLogState.page = data.page || 1;

      renderQueriesLogs(data);
      renderQueriesLogPagination();
    }).catch(function (err) {
      emptyState("queriesLogContent", "Could not load activity log: " + err.message);
    });
  }

  function renderQueriesLogs(data) {
    var logs = data.logs || [];
    var html = '';

    // Filters bar
    html += '<div class="admin-card queries-log-filters">';
    html += '<h3>Query / Activity Log</h3>';
    html += '<div class="filter-row">';
    html += '<input type="text" id="queriesLogSearchInput" placeholder="Search queries..." class="filter-input" style="flex:1; max-width:300px;" value="' + _queriesLogState.filters.search + '">';
    html += '<select id="queriesLogTypeFilter" class="filter-select">' +
      '<option value="">All Types' + (_queriesLogState.filters.activity_type === 'rag' ? ', selected' : '') +
