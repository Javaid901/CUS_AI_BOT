    } else {
      return;
    }

    showLoading(containerId + "Logs");

    var params = new URLSearchParams();
    params.append("period", period);
    params.append("page", 1);
    params.append("page_size", 20);
    params.append("category", category);

    fetchJSON(BASE + "/logs?" + params.toString()).then(function (data) {
      var logs = data.logs || [];
      var total = data.total || 0;

      var html = '<div class="admin-card category-logs-card">';
      html += '<h3>Recent ' + category.charAt(0).toUpperCase() + category.slice(1) + ' Activity (' + total + ' total)</h3>';

      if (logs.length === 0) {
        html += '<div class="insight-empty"><p>No ' + category + ' activity yet.</p></div>';
      } else {
        html += '<div class="category-logs-table-wrapper">';
        html += '<table class="insight-table category-logs-table">';
        html += '<thead><tr><th>Time</th><th>Type</th><th>Query / Action</th><th>Programme</th><th>Result</th><th>Time (ms)</th><th>Actions</th></tr></thead><tbody>';
        logs.forEach(function (log) {
          html += '<tr data-log-id="' + esc(log.id) + '">';
          html += '<td>' + esc(log.time_display) + '</td>';
          html += '<td><span class="badge badge-' + getBadgeClass(log.activity_type) + '">' + esc(log.activity_label) + '</span></td>';
          html += '<td class="query-cell">' + esc(log.query_text || log.activity_label) + '</td>';
          html += '<td>' + esc(log.programme || "–") + '</td>';
          html += '<td><span class="badge badge-' + getResultBadgeClass(log.result_status) + '">' + esc(log.result_status) + '</span></td>';
          html += '<td>' + (log.response_time_ms ? log.response_time_ms + "ms" : "–") + '</td>';
html += '<td><button class="btn sm red" onclick="deleteTrendingLogDetail(\'' + esc(log.id) + '\')" title="Delete log">🗑</button></td>';
          html += '</tr>';
        });
        html += '</tbody></table>';
        html += '</div>';
      }
