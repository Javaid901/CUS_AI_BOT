  function loadCategoryLogs(containerId, period, category) {
    var logContainer = document.createElement("div");
    logContainer.id = containerId + "Logs";
    logContainer.className = "category-logs";
    logContainer.style.marginTop = "24px";

    var targetContainer = document.getElementById(containerId);
    if (targetContainer) {
