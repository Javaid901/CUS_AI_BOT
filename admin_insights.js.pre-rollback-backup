  function loadQueriesLog(period) {
    // Reset filters on initial load
    _queriesLogState.filters = {
      search: "",
      activity_type: "",
      result_status: "",
      category: "",
      programme: "",
      college: "",
      service: "",
      date_from: "",
      date_to: "",
    };
    _queriesLogState.page = 1;
    _queriesLogState.selectedLogs.clear();
    fetchQueriesLogs(period);
