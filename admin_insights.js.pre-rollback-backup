  function bindQueriesLogFilterEvents() {
    var searchInput = document.getElementById("queriesLogSearchInput");
    if (searchInput) {
      searchInput.addEventListener("keydown", function (e) { if (e.key === "Enter") applyQueriesLogFilters(); });
    }
    document.getElementById("queriesLogTypeFilter").addEventListener("change", applyQueriesLogFilters);
    document.getElementById("queriesLogResultFilter").addEventListener("change", applyQueriesLogFilters);
    document.getElementById("queriesLogCategoryFilter").addEventListener("change", applyQueriesLogFilters);
    document.getElementById("queriesLogDateFrom").addEventListener("change", applyQueriesLogFilters);
    document.getElementById("queriesLogDateTo").addEventListener("change", applyQueriesLogFilters);
    document.getElementById("queriesLogPageSize").addEventListener("change", function (e) {
      _queriesLogState.pageSize = parseInt(e.target.value);
      _queriesLogState.page = 1;
      fetchQueriesLogs(getPeriod());
    });
var selectAll = document.getElementById("queriesLogSelectAll");
    if (selectAll) {
      selectAll.addEventListener("change", function (e) {
        document.querySelectorAll(".queries-log-row-checkbox").forEach(function (cb) {
          cb.checked = e.target.checked;
          toggleQueriesLogRowSelect(cb);
        });
      });
    }
    // Bind individual row checkbox change
    document.querySelectorAll(".queries-log-row-checkbox").forEach(function (cb) {
      cb.addEventListener("change", function (e) {
        toggleQueriesLogRowSelect(e.target);
      });
    });
    // Bind delete button click - use event delegation on the table
    document.querySelectorAll(".queries-logs-table tbody button").forEach(function (btn) {
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        var id = btn.getAttribute("data-id");
        if (id) {
          deleteQueriesLogDetail(id);
        }
      });
    });
    // Bind pagination page change - re-fetch the current page
    document.querySelectorAll(".queries-log-pagination button").forEach(function (btn) {
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        var page = btn.dataset ? btn.dataset.page : null;
        if (page !== null) {
          changeQueriesLogPage(page);
        }
      });
    });
  }
    // Bind individual row checkbox change
    document.querySelectorAll(".queries-log-row-checkbox").forEach(function (cb) {
      cb.addEventListener("change", function (e) {
        toggleQueriesLogRowSelect(e.target);
      });
    });
